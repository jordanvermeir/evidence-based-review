       type: object
       properties:
         content:
           title: Content
           description: Pet owners in the requested page.
           type: array
           items:
             $ref: '#/components/schemas/Owner'
         page:
           title: Page
           description: Zero-based page index.
           type: integer
           format: int32
           minimum: 0
           example: 0
         size:
           title: Size
           description: Requested page size.
           type: integer
           format: int32
           minimum: 1
           example: 5
         totalElements:
           title: Total elements
           description: Total number of owners matching the request.
           type: integer
           format: int64
           minimum: 0
           example: 10
         totalPages:
           title: Total pages
           description: Total number of pages matching the request.
           type: integer
           format: int32
           minimum: 0
           example: 2
       required:
         - content

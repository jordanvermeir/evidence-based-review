+package auth;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+class EmailValidatorTest {
+
+    private final EmailValidator validator = new EmailValidator();
+
+    @Test
+    void acceptsPlainAddress() {
+        assertTrue(validator.isValid("alice@example.com"));
+    }
+
+    @Test
+    void rejectsMalformedEmail() {
+        assertFalse(validator.isValid("alice@"));
+        assertFalse(validator.isValid("no-at-sign.example.com"));
+        assertFalse(validator.isValid("two@@example.com"));
+    }
+}

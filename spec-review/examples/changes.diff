+package auth;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+class PasswordPolicyTest {
+
+    private final PasswordPolicy policy = new PasswordPolicy();
+
+    @Test
+    void rejectsShortPassword() {
+        assertThrows(WeakPasswordException.class, () -> policy.check("short1"));
+    }
+
+    @Test
+    void rejectsPasswordWithoutDigit() {
+        assertThrows(WeakPasswordException.class, () -> policy.check("correct horse battery"));
+    }
+
+    @Test
+    void acceptsLongPasswordWithDigit() {
+        assertDoesNotThrow(() -> policy.check("correct horse 1"));
+    }
+}
